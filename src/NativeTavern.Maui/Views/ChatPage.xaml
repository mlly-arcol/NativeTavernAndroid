<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NativeTavern.Maui.ViewModels"
             x:Class="NativeTavern.Maui.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="NativeTavern">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Padding="10,8"
          RowSpacing="8">

        <!-- Session header: switch, create, delete, settings -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <Picker Grid.Column="0"
                    ItemsSource="{Binding Sessions}"
                    SelectedItem="{Binding SelectedSession}"
                    ItemDisplayBinding="{Binding Title}" />
            <Button Grid.Column="1" Text="＋" Clicked="OnNewChatClicked" />
            <Button Grid.Column="2" Text="🗑" Clicked="OnDeleteChatClicked" />
            <Button Grid.Column="3" Text="⚙" Clicked="OnOpenSettingsClicked" />
        </Grid>

        <!-- Messages -->
        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource CardBackground}"
                            Padding="12,8"
                            Margin="0,2">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding RoleLabel}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="{StaticResource AccentColor}" />
                                <Label Text="正在输入…"
                                       FontSize="12"
                                       IsVisible="{Binding IsStreaming}"
                                       TextColor="{StaticResource MutedText}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Content}"
                                   LineBreakMode="WordWrap"
                                   TextType="Text" />
                            <Label Text="{Binding StatusSummary}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasStatusSummary}"
                                   TextColor="{StaticResource MutedText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Reply suggestions -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    IsVisible="{Binding HasSuggestions}">
            <HorizontalStackLayout Spacing="6"
                                   BindableLayout.ItemsSource="{Binding ReplySuggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding}"
                                Clicked="OnSuggestionClicked" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Input -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Editor Grid.Column="0"
                    x:Name="InputEditor"
                    Text="{Binding InputText}"
                    AutoSize="TextChanges"
                    Placeholder="输入消息…"
                    Completed="OnInputCompleted" />
            <Button Grid.Column="1"
                    Text="发送"
                    Command="{Binding SendCommand}"
                    IsVisible="{Binding IsIdle}" />
            <Button Grid.Column="1"
                    Text="停止"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsGenerating}" />
        </Grid>

    </Grid>
</ContentPage>
